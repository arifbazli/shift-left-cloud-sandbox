{
  "theme": "base",
  "themeVariables": {
    "fontSize": "11px",
    "fontFamily": "ui-sans-serif, 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "fontWeight": "500",
    "primaryColor": "#ffffff",
    "primaryBorderColor": "#0a0a0a",
    "primaryTextColor": "#0a0a0a",
    "lineColor": "#0a0a0a",
    "secondaryColor": "#fafafa",
    "tertiaryColor": "#f5f5f5",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#0a0a0a",
    "titleColor": "#0a0a0a",
    "edgeLabelBackground": "#ffffff",
    "nodeBorder": "#0a0a0a",
    "mainBkg": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "linear",
    "nodeSpacing": 0,
    "rankSpacing": 8,
    "wrappingWidth": 80,
    "padding": 4,
    "defaultRenderer": "elk"
  }
}
