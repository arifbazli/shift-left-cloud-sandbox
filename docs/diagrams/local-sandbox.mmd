flowchart LR
    subgraph L["LOCAL SANDBOX"]
        direction TB
        TF["Terraform + tfsec"]
        FL["Floci Podman"]
        CK["Checks"]
        AG["Bounded agent"]
        SN["Snapshot + act"]
        TF --> FL --> CK --> AG --> SN
    end

    subgraph SY["SYNC"]
        direction TB
        GATE["Credential gate"]
        SN --> GATE
    end

    subgraph C["PUBLIC"]
        direction TB
        REPO[("GitHub repo")]
        PAGES["Cloudflare Pages"]
        REPO --> PAGES
    end

    GATE -->|"push"| REPO

    classDef section fill:#0a0a0a,stroke:#0a0a0a,color:#ffffff,stroke-width:1px
    classDef black fill:#0a0a0a,stroke:#0a0a0a,color:#ffffff,stroke-width:2px
    classDef white fill:#ffffff,stroke:#0a0a0a,color:#0a0a0a,stroke-width:1.5px
    classDef diamond fill:#0a0a0a,stroke:#0a0a0a,color:#ffffff,stroke-width:2px

    class L,SY,C section
    class TF,FL,CK,AG,SN black
    class GATE diamond
    class REPO,PAGES white
